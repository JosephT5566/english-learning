APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://english_learning:english_learning@localhost:5432/english_learning
DATABASE_CONNECT_TIMEOUT_SECONDS=2
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_ALLOWED_EMAILS=allowed-user@example.com
# Uncomment to enable provider-backed card embeddings and semantic search.
# VERTEX_PROJECT_ID=replace-with-google-cloud-project-id
# VERTEX_LOCATION=us-central1
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Operator-only public content publication. Keep empty until release gates pass.
PUBLIC_REVIEW_DECK_IDS=[]
PUBLIC_REVIEW_REQUESTS_PER_MINUTE=6
PUBLIC_REVIEW_BURST=2
PUBLIC_REVIEW_GLOBAL_REQUESTS_PER_MINUTE=60
PUBLIC_REVIEW_GLOBAL_BURST=10
PUBLIC_REVIEW_MAX_IN_FLIGHT=1
PUBLIC_REVIEW_QUERY_TIMEOUT_MS=2000

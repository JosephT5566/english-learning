  "additionalProperties": false,
  "description": "Bounded, content-only JSON authoring envelope; never a write command.",
  "properties": {
    "cards": {
      "items": {
        "$ref": "#/$defs/CardFields"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Cards",

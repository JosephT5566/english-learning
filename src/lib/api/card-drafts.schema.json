            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Romanization"
        },
        "supplementary_note": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supplementary Note"

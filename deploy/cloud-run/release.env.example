# Non-secret release configuration. Copy this file outside the repository or to
# release.env (which is ignored) and replace every placeholder before sourcing it.
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_REGION=asia-southeast1
ARTIFACT_REGION=asia-east1
ARTIFACT_REPOSITORY=language-learning
API_IMAGE_NAME=api
API_SERVICE=english-learning-api
MIGRATION_JOB=english-learning-api-migrate
RUNTIME_SERVICE_ACCOUNT=english-learning-api@replace-with-gcp-project-id.iam.gserviceaccount.com
MIGRATION_SERVICE_ACCOUNT=english-learning-migrate@replace-with-gcp-project-id.iam.gserviceaccount.com
RUNTIME_DATABASE_SECRET=english-learning-neon-runtime-url
RUNTIME_DATABASE_SECRET_VERSION=1
MIGRATION_DATABASE_SECRET=english-learning-neon-migration-url
MIGRATION_DATABASE_SECRET_VERSION=1
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
CORS_ALLOWED_ORIGINS='["https://josepht5566.github.io"]'
